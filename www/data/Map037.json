"indent":0,"parameters":["workerface1 (2)",7,0,2]},{"code":401,"indent":0,"parameters":["\\n<Mr.Robert > 接受死亡这件事本身就很复杂，"]},{"code":401,"indent":0,"parameters":["尤其是面对自己的死亡时"]},{"code":230,"indent":0,"parameters":[30]},{"code":213,"indent":0,"parameters":[-1,7,true]},{"code":250,"indent":0,"parameters":[{"name":"33788__jobro__5-beep-b","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["脸部3223424124",6,0,2]},{"code":401,"indent":0,"parameters":["\\n<Rebecca>我…… 不太擅长…… 谈论自己的感受，"]},{"code":401,"indent":0,"parameters":["这纯属浪费时间"]},{"code":230,"indent":0,"parameters":[30]},{"code":250,"indent":0,"parameters":[{"name":"33788__jobro__5-beep-b","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["脸部3223424124",1,0,2]},{"code":401,"indent":0,"parameters":["\\n<Rebecca>你说你是死神，在这里那是类似死亡"]},{"code":401,"indent":0,"parameters":["警察之类的工作吗"]},{"code":230,"indent":0,"parameters":[30]},{"code":213,"indent":0,"parameters":[1,2,false]},{"code":250,"indent":0,"parameters":[{"name":"bllrr-text-loop-82399","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["workerface1 (2)",7,0,2]},{"code":401,"indent":0,"parameters":["\\n<Mr.Robert> 我更愿意把我们称作死亡心理"]},{"code":401,"indent":0,"parameters":["疏导者"]},{"code":230,"indent":0,"parameters":[30]},{"code":250,"indent":0,"parameters":[{"name":"bllrr-text-loop-82399","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["workerface1 (2)",7,0,2]},{"code":401,"indent":0,"parameters":["\\n<Mr.Robert > 虽然我们确实会和怪物战斗，"]},{"code":401,"indent":0,"parameters":["但我们的主要工作，是帮助像你这样迷失的"]},{"code":401,"indent":0,"parameters":["灵魂接受自己的死亡"]},{"code":230,"indent":0,"parameters":[30]},{"code":250,"indent":0,"parameters":[{"name":"bllrr-text-loop-82399","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["workerface1 (2)",7,0,2]},{"code":401,"indent":0,"parameters":["\\n<Mr.Robert > 并让他们可以独自在这死后世界"]},{"code":401,"indent":0,"parameters":["生存下去"]},{"code":230,"indent":0,"parameters":[30]},{"code":213,"indent":0,"parameters":[-1,7,true]},{"code":250,"indent":0,"parameters":[{"name":"33788__jobro__5-beep-b","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["脸部3223424124",3,0,2]},{"code":401,"indent":0,"parameters":["\\n<Rebecca>我连死后都得去做心理治疗，"]},{"code":401,"indent":0,"parameters":["真麻烦"]},{"code":230,"indent":0,"parameters":[30]},{"code":250,"indent":0,"parameters":[{"name":"33788__jobro__5-beep-b","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["脸部3223424124",3,0,2]},{"code":401,"indent":0,"parameters":["\\n<Rebecca>你知道我是怎么死的吗，老实说，"]},{"code":401,"indent":0,"parameters":["这是我现在唯一在乎的事"]},{"code":230,"indent":0,"parameters":[30]},{"code":213,"indent":0,"parameters":[1,6,true]},{"code":250,"indent":0,"parameters":[{"name":"bllrr-text-loop-82399","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["workerface1 (2)",7,0,2]},{"code":401,"indent":0,"parameters":["\\n<Mr.Robert> 我还不知道你是怎么死的，"]},{"code":401,"indent":0,"parameters":["我们可以在你的灵魂档案里找到答案"]},{"code":230,"indent":0,"parameters":[30]},{"code":213,"indent":0,"parameters":[-1,2,true]},{"code":250,"indent":0,"parameters":[{"name":"33788__jobro__5-beep-b","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["脸部3223424124",6,0,2]},{"code":401,"indent":0,"parameters":["\\n<Rebecca>我的…… 灵魂档案"]},{"code":230,"indent":0,"parameters":[30]},{"code":250,"indent":0,"parameters":[{"name":"bllrr-text-loop-82399","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["workerface1 (2)",7,0,2]},{"code":401,"indent":0,"parameters":["\\n<Mr.Robert> 那是一份案件档案，里面记录"]},{"code":401,"indent":0,"parameters":["了你完整的人生经历"]},{"code":230,"indent":0,"parameters":[30]},{"code":250,"indent":0,"parameters":[{"name":"bllrr-text-loop-82399","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["workerface1 (2)",7,0,2]},{"code":401,"indent":0,"parameters":["\\n<Mr.Robert > 它应该就在我的办公室里某个地方"]},{"code":230,"in